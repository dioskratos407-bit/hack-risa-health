# Copiar este archivo como .env.local y completar los valores.
# .env.local esta en .gitignore: las claves reales NUNCA se versionan.

# --- Supabase (proyecto propio) ---
# URL del proyecto (Dashboard -> Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://TU_PROYECTO.supabase.co
# Clave anon: SOLO lectura (las tablas tienen RLS activo, ver supabase/rls.sql)
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Clave service_role: escritura desde el servidor. Sin prefijo NEXT_PUBLIC_
# para que Next.js jamas la incluya en el bundle del navegador.
SUPABASE_SERVICE_ROLE_KEY=

# --- Google Gemini (analisis contextual con IA) ---
# Obtener en https://aistudio.google.com/apikey
GEMINI_API_KEY=
