# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# la plantilla sin claves SI se versiona (reproducibilidad)
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# data & large csv files
*.csv
datos/*.csv
# la auditoria del ETL SI se versiona: solo contiene conteos por etapa (evidencia
# de limpieza), ningun dato de paciente
!datos/data_quality_audit.csv

